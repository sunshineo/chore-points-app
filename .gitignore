# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/web/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/web/coverage

# next.js
/.next/
/out/
/web/.next/
/web/out/

# Serwist service worker build output
/public/sw.js
/public/sw.js.map
/web/public/sw.js
/web/public/sw.js.map

# production
/build
/web/build

# misc
.DS_Store
*.pem

# worktrees
.worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/web/src/generated/prisma

# SSH keys
Chore_app
Chore_app.pub
.env*.local
