generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PointEntry {
  id        String   @id
  type      String
  itemId    String
  points    Int
  dateKey   String
  date      DateTime
  createdAt DateTime @default(now())

  @@index([dateKey])
  @@index([dateKey, type, itemId])
}

model PointBalance {
  id        String   @id
  totalNet  Int
  updatedAt DateTime @updatedAt
}
